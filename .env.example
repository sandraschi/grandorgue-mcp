# GrandOrgue MCP — Environment Variables
# Copy this file to .env and fill in your values.

# GrandOrgue executable path (auto-detected if omitted)
# GO_EXE_PATH=C:\Program Files\GrandOrgue\GrandOrgue.exe

# MIDI depot directory (defaults to repo midi_depot/ or %APPDATA%/GrandOrgue-mcp/midi_depot)
# MIDI_DEPOT_DIR=

# MIDI recordings directory (defaults to GrandOrgue's configured recordings dir)
# GO_MIDI_RECORDINGS_DIR=

# Ollama base URL for local LLM chat
# OLLAMA_BASE_URL=http://127.0.0.1:11434

# LM Studio base URL for local LLM chat
# LMSTUDIO_BASE_URL=http://127.0.0.1:1234
